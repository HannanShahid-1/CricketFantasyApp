# Raw downloads (re-fetch with "Update Data.bat" or scripts/build_data.py)
data/raw/
data/build/

# Logs
*.log
npm-debug.log*

# Local env and secrets — never commit these
.env
.env.*
*.local

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.venv/
