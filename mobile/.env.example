# Copy to .env.local (git-ignored) and fill in your own values. Only needed to install the app with Xcode.
# Bundle ID: any reverse-domain name unique to you, e.g. com.yourname.seam
SEAM_BUNDLE_ID=com.yourname.seam
# Team ID: Xcode -> Settings -> Accounts -> your Apple ID -> Personal Team (or developer.apple.com -> Membership)
SEAM_APPLE_TEAM_ID=
